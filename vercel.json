{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-flutter-web.sh",
  "outputDirectory": "lingo_app/build/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lingo-backend.onrender.com/:path*"
    },
    {
      "source": "/api",
      "destination": "https://lingo-backend.onrender.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
