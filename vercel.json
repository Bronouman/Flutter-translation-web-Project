{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-flutter-web.sh",
  "outputDirectory": "lingo_app/build/web",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://lingo-backend.onrender.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
