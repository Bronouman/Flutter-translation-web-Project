{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-flutter-web.sh",
  "outputDirectory": "lingo_app/build/web",
  "rewrites": [
    {
      "source": "/api/translate",
      "destination": "https://lingo-backend.onrender.com/translate"
    },
    {
      "source": "/api/detect",
      "destination": "https://lingo-backend.onrender.com/detect"
    },
    {
      "source": "/api/speak",
      "destination": "https://lingo-backend.onrender.com/speak"
    },
    {
      "source": "/api/health",
      "destination": "https://lingo-backend.onrender.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
